# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored so your password never gets committed.

# SQLAlchemy database URL. Format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/urlshortener

# Base URL used to build returned short links.
BASE_URL=http://localhost:8000
